# ---------------------------------------------------------------------------
# BoS Data Repository Portal — copy to .env and fill in
# ---------------------------------------------------------------------------

# Sessions and CSRF tokens are signed with this. Generate one per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=jain_bos_portal

# The bootstrap administrator, created on first run only. The portal asks for
# a new password at the first sign-in.
ADMIN_USERNAME=ooa.admin
ADMIN_PASSWORD=ChangeThisOnFirstLogin!
ADMIN_NAME=Office of Academics

# The year new submissions are filed against. Editable later under Settings.
ACADEMIC_YEAR=2027-28

UPLOAD_ROOT=/var/www/jain-bos-portal/uploads
MAX_CONTENT_MB=32

PORT=8102
FLASK_DEBUG=0

# Leave on. Off means the portal accepts form posts from other sites.
CSRF_PROTECT=1

# Set only behind HTTPS. On plain HTTP the session cookie is never sent and
# nobody can sign in.
SESSION_COOKIE_SECURE=1

# How long the public landing page stays "already seen" for a visitor, in
# days. After that they are introduced to the portal again.
LANDING_SEEN_DAYS=180

# ---------------------------------------------------------------------------
# TEST MODE — never set this on the live portal.
#
# It seeds demo departments, signs anybody in as any account without a
# password, and lets the whole cycle be wiped, all from /test. Every page
# carries a ribbon saying so.
# ---------------------------------------------------------------------------
TEST_MODE=0
